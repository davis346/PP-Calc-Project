{
  "preset": "ts-jest",
  "testEnvironment": "node",
  "moduleNameMapper": {
    "^expo-.*": "<rootDir>/__mocks__/expo.js",
    "^@react-native-async-storage/.*": "<rootDir>/__mocks__/async-storage.js"
  },
  "testMatch": ["**/__tests__/**/*.test.ts"],
  "transform": {
    "^.+\\.tsx?$": ["ts-jest", { "tsconfig": { "jsx": "react" } }]
  }
}
